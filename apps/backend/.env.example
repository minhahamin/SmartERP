# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (docs/07-database-design.md) ─────────────
DATABASE_URL="postgresql://erpilot:erpilot@localhost:5432/erpilot?schema=public"

# ── JWT (docs/12-jwt-auth-design.md) ───────────────────
# 운영: 32자 이상 무작위 문자열 필수 (예: openssl rand -base64 48)
# 약한 기본값(change-me-*)은 부팅 시 검증 실패로 거부된다.
JWT_ACCESS_SECRET="REPLACE_WITH_32_PLUS_RANDOM_STRING__openssl_rand_base64_48"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=14
REFRESH_TOKEN_EXPIRES_DAYS_REMEMBER_ME=30

# ── CORS (콤마 구분 다중 오리진 — Railway FE 공개 URL + 로컬 개발서버) ──
CORS_ORIGIN="http://localhost:5173"
# 프론트↔백엔드 도메인이 다르면(직접 호출) none — 동일 오리진 프록시(/api) 경유면 strict
COOKIE_SAME_SITE="strict"

# ── AI / RAG (docs/09~11) ───────────────────────────────
GEMINI_API_KEY=

# ── 메일 (비밀번호 재설정 링크 발송, 선택) ───────────────
# SMTP_HOST가 비어 있으면 발송하지 않고, 개발 환경에서는 서버 로그에 링크를 출력한다.
FRONTEND_URL="http://localhost:5173"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ERPilot <no-reply@erpilot.io>"

# AI 모델 — 비우면 gemini-2.5-flash. 무료 등급은 이 모델이 "하루 20회"라 데모가 금방 멈추므로,
# 쿼터가 넉넉한 모델(예: gemini-2.5-flash-lite)로 바꾸거나 결제를 연결한다.
GEMINI_MODEL=
# 문서 시맨틱 검색용 임베딩 모델(출력 1536차원 고정, 비우면 gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=

# 매일 도는 업무 자동화(발주 초안, 생산 지연 알림 등). false면 끈다
AUTOMATION_ENABLED=true
