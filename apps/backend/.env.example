# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (docs/07-database-design.md) ─────────────
DATABASE_URL="postgresql://erpilot:erpilot@localhost:5432/erpilot?schema=public"

# ── JWT (docs/12-jwt-auth-design.md) ───────────────────
# 운영: 32자 이상 무작위 문자열 필수 (예: openssl rand -base64 48)
# 약한 기본값(change-me-*)은 부팅 시 검증 실패로 거부된다.
JWT_ACCESS_SECRET="REPLACE_WITH_32_PLUS_RANDOM_STRING__openssl_rand_base64_48"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=14
REFRESH_TOKEN_EXPIRES_DAYS_REMEMBER_ME=30

# ── CORS (콤마 구분 다중 오리진 — Railway FE 공개 URL + 로컬 개발서버) ──
CORS_ORIGIN="http://localhost:5173"
# 프론트↔백엔드 도메인이 다르면(직접 호출) none — 동일 오리진 프록시(/api) 경유면 strict
COOKIE_SAME_SITE="strict"

# ── AI / RAG (docs/09~11) ───────────────────────────────
GEMINI_API_KEY=
